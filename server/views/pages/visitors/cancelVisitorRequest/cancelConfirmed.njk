{% extends "partials/layout.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = t("visitors:cancelVisitorRequestConfirmed.heading") %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {{ govukPanel({
        titleText: pageTitle
      }) }}

      <h2 class="govuk-heading-m">{{ t("common:postBooking.whatHappensNext") }}</h2>

      {% if showLinkNewVisitorButton %}
        <p class="no-visited-state">
          {{- t("visitors:cancelVisitorRequestConfirmed.linkAnotherVisitor") | renderLinkTag((paths.ADD_VISITOR.START + '/' + prisonerDisplayId) if features.multiplePrisoners else paths.ADD_VISITOR.START) | safe -}}
        </p>
      {% endif %}

      <p>
        {{- t("common:postBooking.feedback")
          | renderLinkTag("https://submit.forms.service.gov.uk/form/263703/visit-someone-in-prison/")
          | safe -}}
      </p>

      {% if showLinkNewVisitorButton %}
        <p>
          {{ govukButton({
            text: t("common:buttons.linkNewVisitor"),
            href: paths.ADD_VISITOR.START + '/' + prisonerDisplayId if features.multiplePrisoners else paths.ADD_VISITOR.START,
            attributes: { "data-test": "link-a-visitor" },
            preventDoubleClick: true
          }) }}
        </p>
    {% endif %}

    </div>
  </div>
{% endblock %}

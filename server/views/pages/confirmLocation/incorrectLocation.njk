{% extends "partials/layout.njk" %}

{% set pageTitle = t("confirmLocation:incorrectLocation.title") %}

{% set backLinkHref = paths.PRISONER_MOVED.CONFIRM_LOCATION %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l">{{- t("confirmLocation:incorrectLocation.prisonerNotAtPrison", {
        prisonerFirstName: prisoner.firstName | capitalize,
        prisonName: confirmLocationSelectedPrison | getPrisonName(prisonNames, language)
      }) -}}</h1>

      <p>{{- t("confirmLocation:incorrectLocation.needToKnow")-}}</p>

      <h2 class="govuk-heading-m">{{- t("confirmLocation:incorrectLocation.questionHeading") -}}</h2>

      <p data-test="find-prisoner-link">{{- t("confirmLocation:incorrectLocation.findPrisonerLink") | renderLinkTag("https://www.gov.uk/find-prisoner") | safe -}}</p>

    </div>
  </div>
{% endblock %}

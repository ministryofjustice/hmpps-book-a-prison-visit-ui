{% extends "partials/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "components/dateOfBirthInput.njk" import dateOfBirthInput with context %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/select/macro.njk" import govukSelect %}


{% set pageTitle = t("confirmLocation:pvbPrison.title") %}

{% set backLinkHref = paths.VISITS.HOME %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% include "partials/errorSummary.njk" %}

      <h1 class="govuk-heading-l">{{- t("confirmLocation:pvbPrison.notUsingService", {
        prisonName: prisoner.registeredPrisonId | getPrisonName(prisonNames, language)
      }) -}}</h1>

      <p>{{- t("confirmLocation:pvbPrison.pvbLinkText") | renderLinkTag(pvbUrl) | safe -}}</p>

    </div>
  </div>
{% endblock %}

{% extends "partials/layout.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = t("prisoners:prisoners.title") %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

            {% if prisonersTableRows | length %}
            <h2 class="govuk-heading-m" data-test="prisoners-linked">{{ t("prisoners:prisoners.prisonersLinkedHeading") }}</h2>
            {{ govukTable({
                head: [
                    {
                        text: t("common:labels.name")
                    },
                    {
                        text: t("common:labels.dateOfBirth")
                    }
                ],
                rows: prisonersTableRows,
                attributes: { "data-test": "prisoners-table" }
            }) }}
            {% endif %}

            <h2 class="govuk-heading-m" data-test="link-new-prisoner">{{ t("prisoners:prisoners.linkANewPrisonerHeading") }}</h2>
            <p class="govuk-body-l">{{ t("prisoners:prisoners.linkANewPrisonerText") }}</p>

            {{ govukButton({
                text: t("prisoners:prisoners.linkANewPrisonerRequestLink"),
                href: paths.ADD_PRISONER.LOCATION,
                preventDoubleClick: true,
                attributes: { "data-test": "link-new-prisoner-button"}
            }) }}
        </div>
    </div>
{% endblock %}

{% extends "partials/layout.njk" %}
{% from "components/visitDetailsSummary.njk" import visitDetailsSummary with context %}

{% set activeLink = 'visits-link' %}
{% set pageTitle = t("visits:cancelled.title") %}

{% set backLinkHref = paths.VISITS.HOME %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      <p>{{ t("visits:shared.onlyGovukBookings") }}</p>

      {% if visits | length %}
        {% for visit in visits %}
          {{ visitDetailsSummary({
            visit: visit,
            index: loop.index,
            pathPrefix: paths.VISITS.VISIT_CANCELLED
          }) }}
        {% endfor %}

      {% else %}
        <p data-test="no-visits">{{ t("visits:cancelled.noCancelledVisits") }}</p>
      {% endif %}

    </div>
  </div>

{% endblock %}
